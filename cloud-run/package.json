{
  "name": "@genstadium/cloud-run",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:rules": "tsc --noEmit -p tsconfig.rules.json",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "test": "jest",
    "test:rules": "jest --config jest.rules.config.js"
  },
  "dependencies": {
    "@genstadium/event-config": "*",
    "@remotion/bundler": "^4.0.474",
    "@remotion/renderer": "^4.0.474",
    "express": "^4.19.0",
    "firebase-admin": "^12.0.0",
    "jose": "^5.9.0",
    "livekit-server-sdk": "^2.15.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.7.0"
  }
}
