# Firebase Emulators (set these to point to local emulators)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FUNCTIONS_EMULATOR_HOST=localhost:5001

# Firebase Project
FIREBASE_PROJECT_ID=genstadium-2321

# Cloud Run (local dev)
PORT=8081

# LiveKit Cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://genstadium.livekit.cloud

# Google Cloud Storage
GCS_DVR_BUCKET=genstadium-dvr
GCS_PREFETCH_BUCKET=genstadium-prefetched

# Stripe (web + Android)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App (Expo)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=genstadium-2321.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=genstadium-2321
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=genstadium-2321.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_CLOUD_RUN_URL=http://localhost:8081
